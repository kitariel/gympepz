{
  "name": "gympepz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "next lint && tsc --noEmit",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "pnpm db:seed:exercises && pnpm db:seed:templates && pnpm db:seed:goals",
    "db:seed:exercises": "node prisma/seed-exercises.js",
    "db:seed:goals": "npx tsx scripts/seed-goal-templates.ts",
    "db:seed:templates": "npx tsx scripts/seed-templates.ts",
    "db:migrate:plan-day": "npx tsx scripts/migrate-plan-day-field.ts",
    "db:migrate:exercise-order": "npx tsx scripts/migrate-exercise-order.ts",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:ci": "cypress run --browser chrome"
  },
