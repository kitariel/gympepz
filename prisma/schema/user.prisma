model User {
    id                  String     @id @default(cuid())
    email               String     @unique
    name                String?
    image               String?
    emailVerified       DateTime?
    passwordHash        String?
    otpCodeHash         String?
    otpExpiresAt        DateTime?
    otpRequestedAt      DateTime?
    // New: verification attempt rate limiting
    otpVerifyAttempts   Int        @default(0)
    otpVerifyLockUntil  DateTime?
    status              UserStatus @default(otp_sent)
    fitnessGoal         String?
    experienceLevel     ExperienceLevel?
    bio                 String?
    failedLoginAttempts Int        @default(0)
    lockUntil           DateTime?
    createdAt           DateTime   @default(now())
    updatedAt           DateTime   @updatedAt

    location     UserLocation?
    accounts     Account[]
    sessions     Session[]
    images       UserImage[]
    programs     Program[]
    activeProgramId String?   @unique
    activeProgram   Program?  @relation("UserActiveProgram", fields: [activeProgramId], references: [id])

    workoutLogs     WorkoutLog[]
    progressEntries ProgressEntry[]
    prs             ExercisePR[]
    streak          WorkoutStreak?
    pageViews       PageView[]
    goals           Goal[]
    workoutLock     WorkoutSessionLock?
    devices         UserDevice[]
}
