model Template {
  id          String   @id @default(cuid())
  name        String
  description String
  tags        String[]
  daysPerWeek Int
  weeks       Int?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  days TemplateDay[]

  @@index([published])
}

model TemplateDay {
  id         String  @id @default(cuid())
  templateId String
  label      String
  day        Int
  order      Int
  isRestDay  Boolean @default(false)

  template Template         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    TemplateExercise[]

  @@index([templateId, order])
}

model TemplateExercise {
  id           String  @id @default(cuid())
  templateDayId String
  exerciseId   String?
  nameFallback String?
  sets         Int
  reps         String
  weight       String?
  order        Int     @default(0)

  day      TemplateDay @relation(fields: [templateDayId], references: [id], onDelete: Cascade)
  exercise Exercise?   @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@index([templateDayId, order])
  @@index([exerciseId])
}
